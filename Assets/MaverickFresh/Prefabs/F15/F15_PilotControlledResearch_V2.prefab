--- !u!114 &7494064987975470137
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6858308790333971268}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a542eddfc5af49408430766429ae4845, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MaverickFresh.FlightDynamics.F15.MavF15PilotControlledFlightDynamicsProfile
  centerOfMassLocalM: {x: 0, y: 0, z: 0}
  gameplayControlAuthority:
    pitchStabilatorDegPerUnit: 10
    rollAileronDegPerUnit: 20
    yawRudderDegPerUnit: 15
    symmetricStabilator:
      minDeg: -25
      maxDeg: -5
      basis: 'MAVERICK_TUNED_NON_AUTHORITATIVE: gameplay command envelope chosen
        to keep the symmetric stabilator inside the setting region the research source
        exercised in its tabulated equilibria. It is a command bound of this gameplay
        layer - NOT a physical hard stop, NOT a sourced travel, and NOT MavF15ResearchDemonstratedControlRange
        (which stays a separate research fact)'
    differentialStabilator:
      minDeg: -6
      maxDeg: 6
      basis: 'MAVERICK_TUNED_NON_AUTHORITATIVE: 0.3 x the aileron envelope (the research
        model''s own differential-tail relation); no sourced differential-tail travel'
    aileron:
      minDeg: -20
      maxDeg: 20
      basis: 'MAVERICK_TUNED_NON_AUTHORITATIVE: gameplay aileron command envelope
        inside the region audited as monotonic and finite in the research rolling-moment
        fit; Table VII exercised 0 deg only'
    rudder:
      minDeg: -15
      maxDeg: 15
      basis: 'MAVERICK_TUNED_NON_AUTHORITATIVE: gameplay rudder command envelope
        inside the region audited as monotonic and finite in the research yawing-moment
        fit; Table VII exercised 0 deg only (flat-spin tables about -3 to +14 deg)'
  trimStart:
    tableViiPoint: 36
    symmetricStabilatorDeg: -15.145285606384277
    alphaDeg: 17.4864559173584
    thetaDeg: 14.546023368835447
    trueAirspeedFtPerSec: 300.8
    altitudeM: 6096
    headingDeg: 0
    sourceNote: 'VALIDATED_RESEARCH_EQUILIBRIUM: Baumann Table VII point 36, recovered
      by the WP-3B symmetric trim solver (stabilator, alpha, theta at V = 300.8 ft/s;
      beta = p = q = r = phi = 0), STABLE in WP-3D, held on the Rigidbody in the
      research closeout'
  debugBuiltProfile:
    profileId: F15_AFIT_BAUMANN_DAVISON_PILOT_CONTROLLED_V1
    displayName: F-15 pilot-controlled research aircraft V1 (AFIT/Baumann/Davison
      aero, Maverick control approximation) - NOT NASA 836, NOT the production F-15
